# A2A smoke-test environment. Copy to .env before docker compose.

# Provider option A: GigaChat B2Bank.
GIGACHAT_B2BANK_BASE_URL=
GIGACHAT_B2BANK_CERT_PATH=
GIGACHAT_B2BANK_KEY_PATH=
GIGACHAT_B2BANK_CA_PATH=
GIGACHAT_B2BANK_VERIFY_SSL=true
# Chat Completions contract: v1 (default) or v2. File uploads always use /v1/files.
GIGACHAT_B2BANK_CHAT_API_VERSION=v1
# v2 only: allow several tool calls per round (model_options.parallel_tool_calls).
GIGACHAT_B2BANK_PARALLEL_TOOL_CALLS=false

# Provider option B: Cloud.ru Foundation Models.
CLOUDRU_FOUNDATION_MODELS_API_KEY=
CLOUDRU_FOUNDATION_MODELS_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Leave empty to let the runtime select defaults for the configured provider.
# Cloud.ru default: cloudru::zai-org/GLM-4.7
# GigaChat default: gigachat-b2bank::GigaChat-Pro
OUROBOROS_MODEL=
OUROBOROS_MODEL_LIGHT=
OUROBOROS_MODEL_FALLBACK=
# Dedicated vision-capable model for the vlm_query tool (image analysis).
# Set when the main model is text-only; empty = fall back to OUROBOROS_MODEL.
OUROBOROS_MODEL_VISION=

# --- Outbound A2A: agents this one may call ---------------------------------
# Off by default; read once at startup, so a change takes effect on restart.
A2A_EGRESS_ENABLED=false
# Seconds a blocking remote call may take before it is cancelled. Long work
# should be submitted with wait=false instead of raising this.
A2A_TOOL_TIMEOUT_SEC=300
# Which agents to call is decided in security_config/a2a.py, not here: the
# server imports that list once at startup, so it ships with the image. The
# module branches on OUROBOROS_POLIGON — DEV is the branch that delegates to
# the legacy A2A_REMOTE_AGENTS key below.
OUROBOROS_POLIGON=DEV
# Legacy, DEV only. A JSON list of remote agents. Each enabled entry becomes
# one tool, a2a__{id}, plus the shared a2a_task_status / a2a_task_cancel tools.
# auth_header/auth_token is the credential that agent asks callers for; both
# must be set or neither is sent. featured_skills selects what the tool
# description mentions and gates nothing.
# Example (single line):
# A2A_REMOTE_AGENTS=[{"id":"researcher","url":"http://agent-b:18800","auth_header":"Authorization","auth_token":"Bearer REPLACE_ME","poll_interval_sec":2}]
A2A_REMOTE_AGENTS=
