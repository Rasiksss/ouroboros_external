# Outbound A2A against the local test agents. The two secure entries declare auth kind user_token,
# which refuses an http:// url, so the secure server listens on https. Make it a certificate for
# 127.0.0.1 first:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 7 -subj "/CN=127.0.0.1" \
#     -addext "subjectAltName=IP:127.0.0.1" -keyout /tmp/a2a-key.pem -out /tmp/a2a-cert.pem
#
# Then start the servers:
#   .venv/bin/python tests/test_helper/a2a/open_agent_server.py       # 18901
#   A2A_TEST_TLS_CERTFILE=/tmp/a2a-cert.pem A2A_TEST_TLS_KEYFILE=/tmp/a2a-key.pem \
#     .venv/bin/python tests/test_helper/a2a/secure_agent_server.py   # 18902, https
#   .venv/bin/python tests/test_helper/a2a/cardless_agent_server.py   # 18903
# Nothing listens on 18909 — that entry is the unreachable-agent scenario, and it is
# supposed to stay dead.
#
# The calling process has to trust that certificate. SSL_CERT_FILE replaces the default roots
# rather than adding to them, and pointed at the certificate alone it breaks every other https peer
# of the process, the model provider included. Give it certifi's roots plus the certificate:
#   cat "$(.venv/bin/python -m certifi)" /tmp/a2a-cert.pem > /tmp/a2a-ca-bundle.pem
# and start the calling process with SSL_CERT_FILE=/tmp/a2a-ca-bundle.pem.
#
# Five entries, so the agent gets five a2a__* tools plus a2a_task_status / a2a_task_cancel:
#   local-open             card and calls both work
#   local-secure           correct bearer token
#   local-secure-badtoken  same agent, wrong token: card reads, calls come back 401
#   local-cardless         no agent card: bare {message} tool, calls still work
#   local-dead             nobody listening: degraded tool, every call fails
#
# What to send them is the scenario table in scripted_agent.py: "slow:20 …" for the timeout
# (A2A_TOOL_TIMEOUT_SEC below is short on purpose), "ask …" for a question that comes back as
# a result, "boom", "reject", "quiet", "message-only".
#
# By hand, the shape scripts/a2a_smoke.sh sends (for 18902 use https://, --cacert with the server's
# certificate and -H 'Authorization: Bearer local-a2a-secret'):
#   curl -s http://127.0.0.1:18901/ -H 'Content-Type: application/json' -d \
#     '{"jsonrpc":"2.0","id":"1","method":"message/send","params":{"message":{"messageId":"m-1","role":"user","parts":[{"kind":"text","text":"ask about the repo"}]}}}'
A2A_EGRESS_ENABLED=true
A2A_TOOL_TIMEOUT_SEC=15
A2A_REMOTE_AGENTS='[{"id":"local-open","name":"Local open agent","enabled":true,"url":"http://127.0.0.1:18901","poll_interval_sec":1},{"id":"local-secure","name":"Local secure agent","enabled":true,"url":"https://127.0.0.1:18902","auth":{"kind":"user_token","auth_header":"Authorization","auth_token":"Bearer local-a2a-secret"},"poll_interval_sec":1},{"id":"local-secure-badtoken","name":"Local secure agent, wrong token","enabled":true,"url":"https://127.0.0.1:18902","auth":{"kind":"user_token","auth_header":"Authorization","auth_token":"Bearer wrong-secret"},"poll_interval_sec":1},{"id":"local-cardless","name":"Local agent without a card","enabled":true,"url":"http://127.0.0.1:18903","poll_interval_sec":1},{"id":"local-dead","name":"Local agent that is not running","enabled":true,"url":"http://127.0.0.1:18909","poll_interval_sec":1}]'

# The other direction, for calling this agent from one of the servers or by hand: JSON-RPC on
# port 18800 accepts anyone who can reach it, so bind it to loopback.
# A2A_ENABLED=true
