# Test skill fixtures — copy these lines into your .env to load
# tests/test_helper/skills instead of the production skills/ directory.
#
# Skill discovery scans exactly one root: <OUROBOROS_REPO_DIR>/skills.
# Pointing REPO_DIR at tests/test_helper therefore swaps the whole skill set
# for the four fixtures below. Nothing else in your .env needs to change.
#
#   test-instruction  type=instruction  prompt text only
#   test-script       type=script       runs via skill_exec
#   test-tool         type=tool         tools under test_tool.*
#   test-extension    type=extension    tools via PluginAPI register(api)
#
# Skills under this root are distribution-owned, so they are auto-enabled and
# their env/permission grants are auto-approved — no manual grant step.

# --- required: point skill discovery at the fixtures ---------------------
# Use an absolute path. Adjust the prefix to wherever you cloned the repo.
OUROBOROS_REPO_DIR=<YOU DIR>/ouroboros/tests/test_helper

# --- optional: keep fixture state out of your real drive -----------------
# Skill state dirs and grant records land under <drive>/state/skills/<name>.
# Leave commented to use the default drive root.
# OUROBOROS_DRIVE_ROOT=/tmp/ouroboros-test-drive

# --- optional: exercise env_from_settings --------------------------------
# Declared by test-script and test-extension. The OUROBOROS_ prefix is
# required: settings only absorb unknown env keys with an allowlisted prefix
# (OUROBOROS_, MCP_, A2A_, TOOL_, GITHUB_, ...), so a bare TEST_SKILL_TOKEN
# would never reach the skill.
#   test-script    -> echo_args.py prints it under env.OUROBOROS_TEST_SKILL_TOKEN
#   test-extension -> ext_settings reports it as present (value is not printed)
OUROBOROS_TEST_SKILL_TOKEN=demo-token-123


# =========================================================================
# Manual smoke test
# =========================================================================
#
# 1. list_skills
#    Expect all four fixtures with enabled=true. available_for_execution is
#    true for test-script only — it flags skill_exec eligibility, and the tool
#    and extension fixtures expose tools instead of running scripts.
#
# 2. Instruction skill
#    Ask the agent for the instruction skill marker.
#    Expect: OUROBOROS_TEST_INSTRUCTION_OK
#
# 3. Script skill
#    skill_exec(skill="distribution:test-script", script="echo_args.py", args=["alpha","beta"])
#      -> exit_code 0, stdout JSON with argv ["alpha","beta"],
#         env.OUROBOROS_TEST_SKILL_TOKEN set, leaked_core_keys []
#    skill_exec(skill="distribution:test-script", script="fail.py")
#      -> SKILL_EXEC_FAILED, exit_code 3, stderr surfaced
#    skill_exec(skill="distribution:test-script", script="slow.py")
#      -> killed at timeout_sec=10, reported as a timeout
#    skill_exec(skill="distribution:test-script", script="scripts/undeclared.py")
#      -> SKILL_EXEC_ERROR: not a declared script
#
# 4. Tool skill (registered with default_enabled=False — enable them first)
#    test_tool.ping             -> marker OUROBOROS_TEST_TOOL_OK
#    test_tool.echo(text="hi", count=2)
#                               -> {"result": ["hi","hi"], ...}
#    test_tool.boom             -> ⚠️ TOOL_ERROR (test_tool.boom): ...
#    test_tool.echo(nope=1)     -> ⚠️ TOOL_ARG_ERROR (test_tool.echo): ...
#
# 5. Extension skill (surface names are mangled; resolve the alias form)
#    test-extension.ext_ping     -> marker OUROBOROS_TEST_EXTENSION_OK
#    test-extension.ext_state(value="hello")
#                                -> read_back "hello", path under the state dir
#    test-extension.ext_settings -> keys ["OUROBOROS_TEST_SKILL_TOKEN"],
#                                   undeclared_key_leaked false
#
# To go back to the real skills, comment out OUROBOROS_REPO_DIR above.
