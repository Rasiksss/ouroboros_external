# The stdio server also exposes `slow_echo`, which answers correctly but late; its default
# delay comes from MCP_SLOW_DELAY_SEC in that entry's "env". See scripts/repro/README.md.
MCP_ENABLED=True
MCP_SERVERS='[{"id":"local-stdio","name":"Local stdio test server","enabled":true,"transport":"stdio","command":"<PYTHON PATH>/python","args":["<DIR PATH>/tests/test_helper/mcp/stdio_server.py"]},{"id":"local-sse","name":"Local SSE test server","enabled":true,"transport":"sse","url":"http://127.0.0.1:8931/sse","auth_header":"X-API-Key","auth_token":"local-sse-secret"},{"id":"local-http","name":"Local streamable HTTP test server","enabled":true,"transport":"streamable_http","url":"http://127.0.0.1:8932/mcp","auth_header":"X-API-Key","auth_token":"local-http-secret"}]'
