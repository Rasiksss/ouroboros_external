# The streamable HTTP server also exposes `slow_echo`, which answers correctly but late; its
# default delay comes from MCP_SLOW_DELAY_SEC in that server's own environment.
# A static token is not expressible over http://, so both entries declare auth none: start both
# servers with MCP_TEST_AUTH_TOKEN= (empty) so neither demands X-API-Key.
MCP_ENABLED=True
MCP_SERVERS='[{"id":"local-sse","name":"Local SSE test server","enabled":true,"transport":"sse","url":"http://127.0.0.1:8931/sse","auth":{"kind":"none"}},{"id":"local-http","name":"Local streamable HTTP test server","enabled":true,"transport":"streamable_http","url":"http://127.0.0.1:8932/mcp","auth":{"kind":"none"}}]'
