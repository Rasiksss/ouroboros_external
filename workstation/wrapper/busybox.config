# BusyBox applet config for the local sandbox rootfs template.
#
# Dockerfile applies this fragment on top of BusyBox allnoconfig and then runs
# oldconfig. Keep this list aligned with Settings.EXEC_ALLOWLIST and Dockerfile.
CONFIG_STATIC=y
CONFIG_LONG_OPTS=y
CONFIG_BUSYBOX=y
# /bin/sh must work because workstation clients run commands as
# ["/bin/sh", "-lc", <user command>]. Wire /bin/sh and /bin/bash to ash.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_CAT=y
CONFIG_PWD=y
CONFIG_ECHO=y
CONFIG_MKDIR=y
CONFIG_TOUCH=y
CONFIG_GREP=y
CONFIG_LS=y
