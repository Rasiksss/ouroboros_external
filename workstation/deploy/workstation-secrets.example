# secman-файл, монтируется в /vault/secrets/secret-files/workstation-secrets
# Формат dotenv (KEY=value) или плоский JSON-объект. Непустые значения
# перекрывают configmap; пустые (KEY=) игнорируются -> остаётся значение из
# configmap. Значения читаются в память процесса и передаются в Settings
# напрямую, в os.environ не попадают (иначе их наследовали бы дочерние
# процессы, включая песочные сессии).

DATABASE_URL=postgresql+asyncpg://workstation:CHANGE_ME@pg.dev0.svc.cluster.local:5432/workstation

# обязателен при IS_CREATE_SESSION_SECRET=true; должен совпадать с
# WORKSTATION_SESSION_CREATE_SECRET в AEFClaw.
SESSION_CREATE_SECRET=CHANGE_ME

# только при WORKSPACE_STORE_ENABLED=true; передаются в boto3 явно из Settings
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=
