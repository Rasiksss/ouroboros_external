# === Service (app/core/config.py) ===
SERVICE_NAME=workstation-bwrap
APP_TITLE=AEF Workstation
APP_DESCRIPTION=Сервис изолированных рабочих сессий для выполнения команд и работы с файлами.
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8080
APP_WORKERS=1
APP_IS_RELOAD=true
APP_LOG_LEVEL=INFO
APP_LOG_DIR=/var/log/app
APP_ROOT_PATH=
NODOC=false
IS_ERR_DETAIL_HIDDEN=false
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
TIMEZONE_NAME=UTC

# === Database (app/core/config.py) ===
DATABASE_URL=sqlite+aiosqlite:////tmp/workstation.db
DATABASE_SCHEMA=public
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
ROOTFS_TEMPLATE_DIR=/var/lib/workstation/template
ROOTFS_ROOT=/var/lib/workstation/sessions
SANDBOX_BINARY=/usr/local/bin/ws-sandbox
BWRAP_BINARY=bwrap
SYSTEMD_RUN_BINARY=systemd-run
RUNTIME_MODE=local
MAX_FILE_SIZE=20971520
MAX_TOTAL_BYTES=104857600
MEMORY_LIMIT_BYTES=536870912
CPU_QUOTA_PCT=100
MAX_TASKS=256
SESSION_MEMORY_MAX=536870912
SESSION_PIDS_MAX=64
SESSION_CPU_QUOTA_PCT=50
SESSION_RLIMIT_AS=1073741824
SESSION_RLIMIT_FSIZE=104857600
SESSION_RLIMIT_CPU_SEC=60
SESSION_RLIMIT_NOFILE=256
SESSION_RLIMIT_NPROC=1024
SESSION_FILE_WATCHDOG_INTERVAL_SEC=2.0
EXEC_ALLOWLIST=/bin/sh,/bin/bash,/bin/cat,/bin/ls,/bin/pwd,/bin/grep,/bin/mkdir,/bin/touch,/bin/echo,/bin/python3,/bin/python,/bin/unrar,/bin/7za
EXEC_TIMEOUT_SEC=300
EXEC_OUTPUT_LIMIT_BYTES=1048576
SIGTERM_GRACE_SEC=3
SESSION_IDLE_TIMEOUT_SEC=900
SESSION_ABSOLUTE_TTL_SEC=3600
CLEANUP_INTERVAL_SEC=60
IS_CREATE_SESSION_SECRET=false
# SESSION_CREATE_SECRET is supplied by SecMan when enforcement is enabled.
WORKSPACE_STORE_ENABLED=false
WORKSPACE_STORE_BACKEND=s3
WORKSPACE_STORE_S3_BUCKET=
WORKSPACE_STORE_S3_PREFIX=workstation/workspaces
WORKSPACE_STORE_S3_ENDPOINT_URL=
WORKSPACE_STORE_RESTORE_TIMEOUT_SEC=300
WORKSPACE_STORE_SNAPSHOT_TIMEOUT_SEC=300
# S3 credentials and SESSION_CREATE_SECRET should be supplied through
# /vault/secrets/secret-files/workstation-secrets (or SECMAN_SECRETS_FILE).
SECMAN_SECRETS_FILE=/vault/secrets/secret-files/workstation-secrets
AWS_REGION=
ENV_ALLOWLIST=PATH,LANG,LC_ALL,HOME,PWD,TERM,USER,OPENCLAW_SHELL
DENY_COMMAND_TOKENS=sudo,mount,iptables,docker,podman
METRICS_ENABLED=true

# === Kafka system events (app/core/clients/kafka/config.py) ===
KAFKA_ENABLED=true
KAFKA_TOPIC=system.events_AIGW
KAFKA_BROKERS=egress-kafka-aigw-collectors.dev0.svc.cluster.local:19093
