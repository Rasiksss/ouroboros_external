{
  "name": "endless",
  "rules": [
    {
      "id": "title-by-light-model",
      "when": {"model": "stub-light"},
      "reply": {"text": "Бесконечный"}
    },
    {
      "id": "subtask-never-ends",
      "when": {"model": "stub-main", "user_contains": "Задача бесконечная"},
      "reply": {"tool_calls": [{"name": "list_available_tools", "arguments": {}}]}
    },
    {
      "id": "root-schedules-subtask",
      "when": {"model": "stub-main", "user_contains": "ход бесконечный", "round": 1},
      "reply": {
        "tool_calls": [
          {"name": "schedule_task", "arguments": {"description": "Задача бесконечная: крутись"}}
        ]
      }
    },
    {
      "id": "root-never-ends",
      "when": {"model": "stub-main", "user_contains": "ход бесконечный"},
      "reply": {"tool_calls": [{"name": "list_available_tools", "arguments": {}}]}
    }
  ]
}
