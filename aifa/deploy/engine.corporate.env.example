# Окружение AIFA для compose.corporate.yml. Рабочий файл: aifa/deploy/engine.corporate.env.
# Готовые корпоративные PostgreSQL/S3; заменить CHANGE_ME и выданные endpoint.
# Секреты в Git не сохраняются. Значения не дополнять строчными комментариями.

# ── Вход ──────────────────────────────────────────────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
FINENGINE_AUTH_SECRET=CHANGE_ME
FINENGINE_ADMIN_USERNAME=admin
FINENGINE_ADMIN_PASSWORD=CHANGE_ME
# Пустой секрет внутренних ручек иначе отключил бы проверку целиком; с флагом — 503 и громкая строка.
FINENGINE_ENFORCE_INTERNAL_AUTH=1

# Секрет внутреннего API инструментов для ouroboros (ADR-0028): тот же, что AIFA_ENGINE_TOKEN в ouroboros.corporate.env.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIFA_ENGINE_TOKEN=CHANGE_ME

# ── PostgreSQL службы (ADR-0013): корпоративная база и выделенная схема ──────────────────────
FINENGINE_PG_SCHEMA=aif-aef-agnbf-af-aifaouroboros-finengine-db
# Адреса ОБЯЗАТЕЛЬНЫ там, где Settings отмечает «пусто = отказ на старте» (auth, documents,
# scenarios, news); остальные включены, чтобы состояние не жило на томе. До решения О2.
FINENGINE_AUTH_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_DIALOGS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_RUNS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_DOCUMENTS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_SCENARIOS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_NEWS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_STATE_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_JOURNALS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev
FINENGINE_ARTIFACTS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@pg.corp.example:5432/aif_aef_metadb_dev

# ── S3 службы: хранилище блобов (store/blobs.py); корзина `finengine`, не `ouroboros` ─────────
FINENGINE_S3_ENDPOINT=https://s3.corp.example
FINENGINE_S3_BUCKET=finengine
FINENGINE_S3_ACCESS_KEY=CHANGE_ME
FINENGINE_S3_SECRET_KEY=CHANGE_ME
FINENGINE_S3_REGION=us-east-1

# ── Workstation контура: комната службы (sealed_room), тот же сервис, что у ouroboros (ADR-0007) ─
FINENGINE_WORKSTATION_URL=http://workstation:8080
# Секрет создания сессии комнаты (ADR-0007, ADR-0028): тот же, что WORKSTATION_CREATE_SECRET у ouroboros
# и AIFA_SYM_WORKSTATION_CREATE_SECRET в aifa/deploy/corporate.env. Пусто — службе заголовок не ставится.
FINENGINE_WORKSTATION_CREATE_SECRET=CHANGE_ME

# ── Модели службы: корпоративный OpenAI-совместимый шлюз ──────────────────────────────────────────────────
# Ключ в engine.corporate.env совпадает с CLOUDRU_FOUNDATION_MODELS_API_KEY в ouroboros.corporate.env; секреты вне git.
FINENGINE_OPENROUTER_BASE_URL=https://llm.corp.example/v1
OPENROUTER_API_KEY=CHANGE_ME
FINENGINE_OPENROUTER_MODEL=CHANGE_ME_MODEL
FINENGINE_PLANNER_MODEL=CHANGE_ME_MODEL
FINENGINE_PLANNER_REASONING_EFFORT=medium
FINENGINE_LOCATE_MODEL=CHANGE_ME_MODEL
FINENGINE_READ_VALUE_MODEL=CHANGE_ME_MODEL
FINENGINE_NEWS_CLASSIFY_MODEL=CHANGE_ME_MODEL

# ── Поиск в сети (ADR-0016: web.search — у AIFA) ──────────────────────────────────────────────
# FINENGINE_TAVILY_API_KEY=CHANGE_ME

# ── Остатки OpenClaw: удаляются шагом 19 (ADR-0009) ───────────────────────────────────────────
# Шлюза OpenClaw в aifa-sym нет, а умолчание Settings (`host.docker.internal:18789`) без
# extra_hosts не разрешается: старый шлюз dev из этого контура недостижим по построению.
# Настройки оставлены здесь, чтобы F10 (шаг 19) нашёл их и убрал вместе с кодом:
# FINENGINE_OPENCLAW_GATEWAY_URL=
# FINENGINE_OPENCLAW_GATEWAY_TOKEN=CHANGE_ME

# ADR-0062: удвоенные бюджеты dev; hard timeout совпадает с ouroboros.
FINENGINE_OUROBOROS_LOOP_MAX_WALL_SEC=2400
FINENGINE_OUROBOROS_SUBTASK_WAIT_SEC=1200
FINENGINE_GRAPH_MIN_WALL_SECONDS=1800
FINENGINE_OUROBOROS_HARD_TIMEOUT_SEC=5400
