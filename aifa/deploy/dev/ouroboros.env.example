# Окружение ouroboros dev-контура aifa-sym. Копия без `.example` — ouroboros.env (в git не попадает).
# Ouroboros настраивается только окружением (ADR-0027); значения ниже — обязательный набор,
# проверяемый F9 по снимку aifa/contracts/dev_config.snapshot.json. Изменение набора — новая ADR.
# Строчных комментариев нет: значение — всё после `=`. Секреты — заглушки `CHANGE_ME`.

# ── Режим (ADR-0002, ADR-0014, ADR-0021) ──────────────────────────────────────────────────────
# Личность из доверенных заголовков; порт закрыт внутренней сетью (ADR-0028).
OUROBOROS_MULTIUSER=true
# WebSocket и HTTP браузерного транспорта, по ним службе отвечает ouroboros.
BROWSER_INGRESS_ENABLED=true
# Корень + автор на пару пользователей (ADR-0008); не меньше 2.
OUROBOROS_WORKER_SLOTS=4
# Стандартный путь + цикл 1200 с + автор с запасом (ADR-0023).
OUROBOROS_HARD_TIMEOUT_SEC=2700

# ── Память и подтверждение выключены (ADR-0010) ───────────────────────────────────────────────
OUROBOROS_MEMORY_DISTILL=false
OUROBOROS_TOOL_CONFIRMATION_ENABLED=false

# ── Инструменты и навыки (ADR-0016, ADR-0022, ADR-0025, ADR-0027) ─────────────────────────────
# ЧЕРНОВЫЕ списки — уточняются в шаге 04 (P3) по list_available_tools живого экземпляра.
# В первый запрос: восемь инструментов навыка aifa-engine (<навык>.<инструмент>).
OUROBOROS_ENABLED_TOOLS=aifa-engine.aifa_goal,aifa-engine.aifa_wait,aifa-engine.aifa_state,aifa-engine.aifa_move,aifa-engine.aifa_finish,aifa-engine.aifa_author_brief,aifa-engine.aifa_author_attempt,aifa-engine.aifa_create_atom
# Чтение файлов и вложений (ADR-0025), веб, расписания, память, картинки, send_* (ADR-0016).
OUROBOROS_DISABLED_TOOLS=attachment_read,vlm_query,data_read,data_list,data_write,send_file,send_image,send_photo,send_user_message,gigasearch,browse_page,browser_action,image_generate,memory_save,memory_read,memory_list,memory_delete,schedule_task,create_scheduled_task,create_reminder,list_schedules,edit_schedule,cancel_schedule,pause_schedule,resume_schedule,confirm_schedule,move_schedule_here
# Все навыки поставки, кроме aifa-* и workstation (ADR-0016). Формат — source-qualified id.
OUROBOROS_DISABLED_SKILLS=distribution:agent-delegation,distribution:calendar-orientation,distribution:docx-tools,distribution:image-generation,distribution:pdf-tools,distribution:tasks-scheduler,distribution:xlsx-tools

# ── Модели: GLM-5.2 через Cloud.ru напрямую, не через infproxy (ADR-0017) ─────────────────────
OUROBOROS_MODEL=cloudru::zai-org/GLM-5.2
OUROBOROS_MODEL_LIGHT=cloudru::zai-org/GLM-5.2
OUROBOROS_MODEL_FALLBACK=cloudru::zai-org/GLM-5.2
CLOUDRU_FOUNDATION_MODELS_API_KEY=CHANGE_ME

# ── PostgreSQL и S3 (ADR-0013); адреса — контейнеры compose.yml, до решения О2 ────────────────
OUROBOROS_RUNTIME_DB_URL=postgresql+psycopg://ouroboros:CHANGE_ME@ouro-postgres:5432/ouroboros
OUROBOROS_S3_BUCKET=ouroboros
OUROBOROS_S3_REGION=us-east-1
OUROBOROS_S3_ENDPOINT=http://s3:8333
OUROBOROS_S3_ACCESS_KEY=CHANGE_ME
OUROBOROS_S3_SECRET_KEY=CHANGE_ME

# ── Ключ шифрования учётных данных (инвариант 8): ровно 64 байта в base64 ─────────────────────
# Сгенерировать: openssl rand -base64 64 | tr -d '\n'
# Без правильного ключа процесс не стартует; смена ключа делает прежние значения нечитаемыми.
OUROBOROS_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME

# ── Workstation контура (ADR-0007, ADR-0028) ──────────────────────────────────────────────────
WORKSTATION_BASE_URL=http://workstation:8080
# Тот же секрет, что у сервиса `workstation` (AIFA_SYM_WORKSTATION_CREATE_SECRET в .env).
WORKSTATION_CREATE_SECRET=CHANGE_ME

# A2A_* и DIALOGS_* не задаются: каналы Dialogs и A2A не включаются (ADR-0016). F9 держит это.
