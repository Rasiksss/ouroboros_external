# Пароли контейнеров инфраструктуры compose-проекта aifa-sym. Копия — `.env` в этом каталоге:
# docker compose подставляет его в compose.yml автоматически. В git не попадает.
# Значения дублируют пароли из ouroboros.env и engine.env (адреса баз, ключи S3, секрет
# Workstation): пароль в `.env` = пароль в адресе базы. Секреты — заглушки `CHANGE_ME`.
# Сгенерировать: openssl rand -hex 24

AIFA_SYM_OURO_PG_PASSWORD=CHANGE_ME
AIFA_SYM_ENGINE_PG_PASSWORD=CHANGE_ME
AIFA_SYM_S3_USER=aifa-sym
AIFA_SYM_S3_PASSWORD=CHANGE_ME
AIFA_SYM_WORKSTATION_CREATE_SECRET=CHANGE_ME
# Отпечаток сборки фронтенда (git sha); по нему вкладка узнаёт, что её код устарел.
AIFA_SYM_BUILD_ID=dev
