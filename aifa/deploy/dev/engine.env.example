# Окружение службы движка (`engine`) dev-контура aifa-sym. Копия без `.example` — engine.env.
# Поля — `Settings` службы (aifa/finengine/src/finengine/config.py). Профиль compose `app`: служба
# поднимается с шага 12, значения уточняются в шагах 04 и 12. Секреты — заглушки `CHANGE_ME`.
# Строчных комментариев нет: значение — всё после `=`. Пустое значение НЕ равно «не задано»
# (оно перекрывает умолчание Settings) — ненужные переменные не пишутся вовсе.

# ── Вход ──────────────────────────────────────────────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
FINENGINE_AUTH_SECRET=CHANGE_ME
FINENGINE_ADMIN_USERNAME=admin
FINENGINE_ADMIN_PASSWORD=CHANGE_ME
# Пустой секрет внутренних ручек иначе отключил бы проверку целиком; с флагом — 503 и громкая строка.
FINENGINE_ENFORCE_INTERNAL_AUTH=1

# ── PostgreSQL службы (ADR-0013): свой сервер engine-postgres, не база ouroboros ─────────────
# Адреса ОБЯЗАТЕЛЬНЫ там, где Settings отмечает «пусто = отказ на старте» (auth, documents,
# scenarios, news); остальные включены, чтобы состояние не жило на томе. До решения О2.
FINENGINE_AUTH_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_DIALOGS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_RUNS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_DOCUMENTS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_SCENARIOS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_NEWS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_STATE_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_JOURNALS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine
FINENGINE_ARTIFACTS_DATABASE_URL=postgresql+psycopg://finengine:CHANGE_ME@engine-postgres:5432/finengine

# ── S3 службы: хранилище блобов (store/blobs.py); корзина `finengine`, не `ouroboros` ─────────
FINENGINE_S3_ENDPOINT=http://s3:8333
FINENGINE_S3_BUCKET=finengine
FINENGINE_S3_ACCESS_KEY=CHANGE_ME
FINENGINE_S3_SECRET_KEY=CHANGE_ME
FINENGINE_S3_REGION=us-east-1

# ── Workstation контура: комната службы (sealed_room), тот же сервис, что у ouroboros (ADR-0007) ─
FINENGINE_WORKSTATION_URL=http://workstation:8080

# ── Модели службы (ADR-0017) ──────────────────────────────────────────────────────────────────
# Извлечение — DeepSeek-V4-Pro через шлюз моделей службы. Адрес шлюза (общий с prod, только как
# приёмник запросов) берётся из deploy/.env старого dev — уточняется в шаге 04, до этого не задаётся:
# FINENGINE_OPENROUTER_BASE_URL=
# OPENROUTER_API_KEY=CHANGE_ME
FINENGINE_OPENROUTER_MODEL=deepseek-ai/DeepSeek-V4-Pro
# До шагов 14 и 17 цикл планирования и автора ведёт служба (ADR-0029): их модели — как на старом dev.
FINENGINE_PLANNER_MODEL=zai-org/GLM-5.2
FINENGINE_PLANNER_REASONING_EFFORT=medium
FINENGINE_ATOM_AUTHOR_MODEL=zai-org/GLM-5.2

# ── Поиск в сети (ADR-0016: web.search — у AIFA) ──────────────────────────────────────────────
FINENGINE_TAVILY_API_KEY=CHANGE_ME

# ── Остатки OpenClaw: удаляются шагом 19 (ADR-0009) ───────────────────────────────────────────
# Шлюза OpenClaw в aifa-sym нет, а умолчание Settings (`host.docker.internal:18789`) без
# extra_hosts не разрешается: старый шлюз dev из этого контура недостижим по построению.
# Настройки оставлены здесь, чтобы F10 (шаг 19) нашёл их и убрал вместе с кодом:
# FINENGINE_OPENCLAW_GATEWAY_URL=
# FINENGINE_OPENCLAW_GATEWAY_TOKEN=CHANGE_ME
