   "occurred_at": "2026-10-06T18:07:44.714262Z",
   "event_type": "legacy",
   "legacy_event": {
    "type": "author_attempt",
    "move": 3,
    "atom": "eph.calc_cv_revenue",
    "attempt": 1,
    "status": "ok",
    "error": null,
    "code": "import numpy as np\n\ndef run(inputs: dict) -> dict:\n    metrics = inputs.get(\"ExtractedMetric\", [])\n    if not metrics:\n        raise ValueError(\"No ExtractedMetric objects found in inputs\")\n\n    values = []\n    for m in metrics:\n        sf = m.get(\"scalar_fact\")\n        if sf is None:\n            continue\n        if sf.get(\"unit\") != \"млн. руб.\":\n            raise ValueError(f\"Unexpected unit: {sf.get('unit')}\")\n        values.append(sf[\"value\"])\n\n    if len(values) < 2:\n        raise ValueError(\"Need at least two values to calculate coefficient of variation\")\n\n    arr = np.array(values, dtype=np.float64)\n    mean = float(np.mean(arr))\n    std_dev = float(np.std(arr, ddof=0))  # population std, as per typical CV definition\n    if mean == 0:\n        raise ValueError(\"Mean is zero, cannot calculate coefficient of variation\")\n    cv = (std_dev / mean) * 100.0\n\n    return {\n        \"coefficient_of_variation\": cv,\n        \"mean\": mean,\n        \"std_dev\": std_dev\n    }\n"
   }
  },
