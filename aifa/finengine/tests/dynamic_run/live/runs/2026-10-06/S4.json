  {
   "schema_version": "1.0",
   "event_id": "8e836280-5514-49d4-b681-1f8f9a85b036",
   "run_id": "bd8cf756-9d7a-490c-a6a2-8bb8ddc59b09",
   "sequence": 7,
   "occurred_at": "2026-10-06T15:42:42.757830Z",
   "event_type": "legacy",
   "legacy_event": {
    "type": "author_attempt",
    "move": 3,
    "atom": "eph.calc_cv_sales_revenue",
    "attempt": 1,
    "status": "ok",
    "error": null,
    "code": "def run(inputs: dict) -> dict:\n    import math\n\n    metrics = inputs.get(\"ExtractedMetric\", [])\n\n    # Ищем значения для 6M 2026 и 6M 2025\n    val_2026 = None\n    val_2025 = None\n\n    for m in metrics:\n        if m.get(\"concept\") != \"SALES_REVENUE\":\n            continue\n        period = m.get(\"period_ref\")\n        sf = m.get(\"scalar_fact\")\n        if not sf:\n            continue\n        unit = sf.get(\"unit\")\n        if unit != \"млн. руб.\":\n            raise ValueError(f\"Ожидалась единица 'млн. руб.', получена '{unit}'\")\n        value = sf.get(\"value\")\n        if value is None:\n            continue\n        if period == \"6M 2026\":\n            val_2026 = value\n        elif period == \"6M 2025\":\n            val_2025 = value\n\n    if val_2026 is None or val_2025 is None:\n        raise ValueError(\"Не найдены оба значения SALES_REVENUE для периодов 6M 2026 и 6M 2025\")\n\n    # Среднее арифметическое\n    mu = (val_2026 + val_2025) / 2.0\n\n    # Стандартное отклонение генеральной совокупности (population std)\n    # σ = sqrt( ((x1 - μ)^2 + (x2 - μ)^2) / N ), где N = 2\n    variance = ((val_2026 - mu) ** 2 + (val_2025 - mu) ** 2) / 2.0\n    sigma = math.sqrt(variance)\n\n    # CV = (σ / μ) * 100\n    if mu == 0:\n        raise ValueError(\"Среднее значение равно нулю, CV не определён\")\n    cv_percent = (sigma / mu) * 100.0\n\n    return {\"cv_percent\": cv_percent}\n"
   }
  },
