   "sequence": 29,
   "occurred_at": "2026-10-06T18:07:09.525731Z",
   "event_type": "legacy",
   "legacy_event": {
    "type": "author_attempt",
    "move": 2,
    "atom": "eph.calc_cv",
    "attempt": 1,
    "status": "ok",
    "error": null,
    "code": "import numpy as np\n\ndef run(inputs: dict) -> dict:\n    metrics = inputs.get(\"ExtractedMetric\", [])\n    if not metrics:\n        raise ValueError(\"No ExtractedMetric objects provided\")\n\n    values = []\n    units = set()\n    for m in metrics:\n        sf = m.get(\"scalar_fact\")\n        if not sf:\n            continue\n        if m.get(\"concept\") != \"SALES_REVENUE\":\n            continue\n        v = sf.get(\"value\")\n        u = sf.get(\"unit\")\n        if v is None or u is None:\n            continue\n        values.append(v)\n        units.add(u)\n\n    if not values:\n        raise ValueError(\"No valid SALES_REVENUE values found\")\n    if len(units) != 1:\n        raise ValueError(f\"Incompatible units: {units}\")\n\n    arr = np.array(values, dtype=np.float64)\n    mean = float(np.mean(arr))\n    std_dev = float(np.std(arr))  # population std (ddof=0)\n    if mean == 0:\n        raise ValueError(\"Mean is zero, cannot compute CV\")\n    cv = (std_dev / mean) * 100.0\n\n    return {\"cv\": cv, \"mean\": mean, \"std_dev\": std_dev}\n"
   }
