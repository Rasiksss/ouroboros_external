   "legacy_event": {
    "type": "author_attempt",
    "move": 5,
    "atom": "eph.build_excel",
    "attempt": 1,
    "status": "ok",
    "error": null,
    "code": "import os\nimport openpyxl\n\ndef run(inputs: dict) -> dict:\n    # Извлекаем ExtractedMetric, игнорируем VerificationFinding\n    metrics = inputs.get(\"ExtractedMetric\", [])\n    if not metrics:\n        raise ValueError(\"Нет входных данных ExtractedMetric\")\n\n    # Собираем значения по концептам и периодам\n    revenue = {}\n    costs = {}\n    for m in metrics:\n        concept = m.get(\"concept\")\n        period = m.get(\"period_ref\")\n        value = m[\"scalar_fact\"][\"value\"]\n        unit = m[\"scalar_fact\"][\"unit\"]\n        if unit != \"млн. руб.\":\n            raise ValueError(f\"Несовместимая единица измерения: {unit}\")\n        if concept == \"SALES_REVENUE\":\n            revenue[period] = value\n        elif concept == \"COSTS_EXPENSES\":\n            costs[period] = value\n        else:\n            continue\n\n    # Проверяем наличие всех нужных периодов\n    required_periods = [\"6M 2025\", \"6M 2026\"]\n    for p in required_periods:\n        if p not in revenue:\n            raise ValueError(f\"Нет данных SALES_REVENUE за период {p}\")\n        if p not in costs:\n            raise ValueError(f\"Нет данных COSTS_EXPENSES за период {p}\")\n\n    # Создаём Excel\n    os.makedirs(\"out\", exist_ok=True)\n    wb = openpyxl.Workbook()\n\n    # Лист 1: Исходные данные\n    ws1 = wb.active\n    ws1.title = \"Исходные данные\"\n    ws1[\"A1\"] = \"Показатель\"\n    ws1[\"B1\"] = \"6M 2025\"\n    ws1[\"C1\"] = \"6M 2026\"\n    ws1[\"A2\"] = \"Выручка\"\n    ws1[\"B2\"] = revenue[\"6M 2025\"]\n    ws1[\"C2\"] = revenue[\"6M 2026\"]\n    ws1[\"A3\"] = \"Себестоимость\"\n    ws1[\"B3\"] = costs[\"6M 2025\"]\n    ws1[\"C3\"] = costs[\"6M 2026\"]\n\n    # Лист 2: Валовая прибыль\n    ws2 = wb.create_sheet(\"Валовая прибыль\")\n    ws2[\"A1\"] = \"Показатель\"\n    ws2[\"B1\"] = \"6M 2025\"\n    ws2[\"C1\"] = \"6M 2026\"\n    ws2[\"A2\"] = \"Валовая прибыль\"\n    ws2[\"B2\"] = \"='Исходные данные'!B2-'Исходные данные'!B3\"\n    ws2[\"C2\"] = \"='Исходные данные'!C2-'Исходные данные'!C3\"\n\n    filename = \"out/Валовая_прибыль.xlsx\"\n    wb.save(filename)\n\n    return {\"file_id\": filename}\n"
   }
