        <mxCell id="GGgtZgyaLu89OSXg350T-11" parent="GGgtZgyaLu89OSXg350T-9" style="rounded=0;whiteSpace=wrap;html=1;" value="Agent Context&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Набор интерфейсов необходимы для работы графа. Изолирует зависимости агента от технологий и позволят менять стек и поверхность исполнения не меняя графа&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="265" x="15" y="40" as="geometry" />
