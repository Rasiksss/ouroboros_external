        <mxCell id="dzkJ4DrB3Htb7meboxWG-11" parent="GGgtZgyaLu89OSXg350T-47" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Agent Runtime&lt;/h1&gt;&lt;p&gt;Runtime вычитывает таски из БД и выполняет их в графе&lt;br&gt;Масштабируется по числу тасок в очереди&lt;/p&gt;" vertex="1">
