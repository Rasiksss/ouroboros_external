          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-41" parent="rtboEt1-Xlqr8ml6nVNy-2" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Event / queue&lt;/h1&gt;&lt;p&gt;Система способна работать с различными очередями в зависимости от требований пользователей&lt;/p&gt;&lt;p&gt;InMemory - для single-user режима&lt;/p&gt;&lt;p&gt;Redis - на старте multi-user режима&lt;/p&gt;&lt;p&gt;Kafka/NATS - в ПРОМ эксплуатации&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
