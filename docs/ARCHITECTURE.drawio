        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-69" parent="GGgtZgyaLu89OSXg350T-47" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Kafka&lt;/h1&gt;&lt;p&gt;Выбираем число партиций kafka в зависимости от нагрузки. Ключ партицирования - user_id, гарантируем последовательную обработку сообщений конкретного пользователя в хронологическом порядке&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="170" x="510" y="350" as="geometry" />
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-70" edge="1" parent="GGgtZgyaLu89OSXg350T-47" style="shape=flexArrow;endArrow=classic;startArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="">
          <mxGeometry height="100" relative="1" width="100" as="geometry">
            <mxPoint x="670" y="229.57999999999993" as="sourcePoint" />
            <mxPoint x="820" y="229.57999999999993" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-74" parent="GGgtZgyaLu89OSXg350T-47" style="rounded=0;whiteSpace=wrap;html=1;" value="Pod&lt;div&gt;Sandbox 1&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="840" y="110" as="geometry" />
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-75" parent="GGgtZgyaLu89OSXg350T-47" style="rounded=0;whiteSpace=wrap;html=1;" value="Pod&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Sandbox&lt;/span&gt;&amp;nbsp;2&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="840" y="200" as="geometry" />
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-76" parent="GGgtZgyaLu89OSXg350T-47" style="rounded=0;whiteSpace=wrap;html=1;" value="Pod&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Sandbox&lt;/span&gt;&amp;nbsp;3&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="840" y="280" as="geometry" />
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-78" parent="GGgtZgyaLu89OSXg350T-47" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Sandbox&lt;/h1&gt;&lt;p&gt;Объединяем различные инстансы в общую consumer group. DropApp следит за числом сообщений в очереди, если число сообщений превышает определенный лимит - добавляем pod&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="190" x="810" y="360" as="geometry" />
        </mxCell>
        <mxCell id="GGgtZgyaLu89OSXg350T-79" parent="GGgtZgyaLu89OSXg350T-47" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Общие вопросы&lt;/h1&gt;&lt;p&gt;Не рассматриваем масштабирование БД, S3 и тд - для нас это сервисы и их масштабирование известная задача&lt;/p&gt;&lt;p&gt;AEF сам отвечает за свое масштабирование, вне нашей области управления&lt;/p&gt;&lt;p&gt;Планируемые sandbox будут масштабироваться по схожим подходам&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="370" x="10" y="580" as="geometry" />
        </mxCell>
        <mxCell id="dzkJ4DrB3Htb7meboxWG-7" parent="GGgtZgyaLu89OSXg350T-47" style="rounded=0;whiteSpace=wrap;html=1;" value="Pod&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Agent Runtime&lt;/span&gt;&amp;nbsp;1&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="1200" y="110" as="geometry" />
        </mxCell>
        <mxCell id="dzkJ4DrB3Htb7meboxWG-8" parent="GGgtZgyaLu89OSXg350T-47" style="rounded=0;whiteSpace=wrap;html=1;" value="Pod&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Agent Runtime&lt;/span&gt;&amp;nbsp;2&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="1200" y="200" as="geometry" />
        </mxCell>
