        <mxCell id="GGgtZgyaLu89OSXg350T-64" parent="GGgtZgyaLu89OSXg350T-47" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Transport&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;Для примера возьмем web + ws&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;DropApp автоматически масштабирует инстансы транспорта на основе утилизации CPU/RAM&lt;/span&gt;&lt;/div&gt;" vertex="1">
