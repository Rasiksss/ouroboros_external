        <mxCell id="GGgtZgyaLu89OSXg350T-68" parent="GGgtZgyaLu89OSXg350T-47" style="rounded=0;whiteSpace=wrap;html=1;" value="Топик Kafka&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IN queue&lt;/span&gt;&lt;/div&gt;" vertex="1">
